# Copy to .env and fill in. .env is gitignored — never commit it.

# Required
ANTHROPIC_API_KEY=

# Milestone 4 — JSearch on RapidAPI
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Milestone 6 — Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
GOOGLE_SHEET_ID=

# Milestone 7 — Gmail alerts (OAuth desktop client)
GMAIL_CREDENTIALS_FILE=secrets/gmail_credentials.json
GMAIL_TOKEN_FILE=secrets/gmail_token.json

# Milestone 9 — Notifications (fill in the channel you use)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
