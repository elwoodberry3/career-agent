<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/install_launchd.sh. __REPO_DIR__ is replaced with the repo path. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.elwood.zoelancaster</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-s</string>
        <string>__REPO_DIR__/.venv/bin/python</string>
        <string>-m</string>
        <string>zoe.main</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>

    <!-- Every 45 min. main.py adds 0–20 min jitter and applies peak/off-peak/quiet rules. -->
    <key>StartInterval</key>
    <integer>2700</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_DIR__/logs/launchd.err.log</string>
</dict>
</plist>
